#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

if (( $# > 0 )); then
  packages=("$@")
else
  require_fzf
  mapfile -t packages < <(pacman -Slq | sort -u | fzf_many "pacman install" "pacman -Si {} 2>/dev/null || true")
fi

(( ${#packages[@]} > 0 )) || die "no package selected"
printf 'Installing: %s\n' "${packages[*]}"
sudo pacman -S --needed "${packages[@]}"
pause
