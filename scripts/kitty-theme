#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/omi_shell"
source_file=${1:-}
output="$base/kitty-theme.conf"

if [[ ! -r $source_file ]]; then
  current=""
  [[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")
  source_file="$base/themes/$current/theme.conf"
fi

[[ -r $source_file ]] || exit 0

background="#1e1e2e"
foreground="#cdd6f4"
accent="#89b4fa"
surface="#181825"
muted="#9399b2"

while IFS='=' read -r key value; do
  key=${key//[[:space:]]/}
  value=${value//[[:space:]\"]/}
  case "$key" in
    BACKGROUND) background=$value ;;
    FOREGROUND) foreground=$value ;;
    ACCENT|BORDER_FOREGROUND) accent=$value ;;
    SURFACE) surface=$value ;;
    MUTED) muted=$value ;;
  esac
done < "$source_file"

valid_color() {
  [[ $1 =~ ^#[[:xdigit:]]{6}$ ]]
}

valid_color "$background" || background="#1e1e2e"
valid_color "$foreground" || foreground="#cdd6f4"
valid_color "$accent" || accent="#89b4fa"
valid_color "$surface" || surface="#181825"
valid_color "$muted" || muted="#9399b2"

mix() {
  local first=${1#\#} second=${2#\#} weight=$3 channel a b mixed result=""
  for channel in 0 2 4; do
    a=$((16#${first:channel:2}))
    b=$((16#${second:channel:2}))
    mixed=$(((a * weight + b * (100 - weight)) / 100))
    printf -v result '%s%02x' "$result" "$mixed"
  done
  printf '#%s' "$result"
}

# Keep body text neutral even when both foreground and muted carry a strong
# palette tint. ANSI colours still provide themed command highlighting.
text_base=$(mix "$foreground" "$muted" 72)
text_hex=${text_base#\#}
text_gray=$(((299 * 16#${text_hex:0:2} + 587 * 16#${text_hex:2:2} + 114 * 16#${text_hex:4:2}) / 1000))
printf -v text_channel '%02x' "$text_gray"
terminal_foreground="#${text_channel}${text_channel}${text_channel}"

# A single accent cannot produce a useful terminal palette. Select distinct,
# high-contrast ANSI hues for dark and light backgrounds instead.
background_hex=${background#\#}
background_brightness=$((
  (299 * 16#${background_hex:0:2}
    + 587 * 16#${background_hex:2:2}
    + 114 * 16#${background_hex:4:2}) / 1000
))

if ((background_brightness < 150)); then
  ansi_black=$(mix "$surface" "$background" 70)
  ansi_red="#f7768e"
  ansi_green="#9ece6a"
  ansi_yellow="#e0af68"
  ansi_blue="#7aa2f7"
  ansi_magenta="#bb9af7"
  ansi_cyan="#7dcfff"
  bright_black="$muted"
  bright_red="#ff8fa3"
  bright_green="#b9e87f"
  bright_yellow="#f4c97a"
  bright_blue="#9bb8ff"
  bright_magenta="#d0afff"
  bright_cyan="#9de4ff"
else
  ansi_black="$foreground"
  ansi_red="#a91f3a"
  ansi_green="#326b20"
  ansi_yellow="#795000"
  ansi_blue="#254d99"
  ansi_magenta="#663099"
  ansi_cyan="#00636b"
  bright_black=$(mix "$foreground" "$background" 80)
  bright_red="#c52b49"
  bright_green="#407f29"
  bright_yellow="#936300"
  bright_blue="#3263bd"
  bright_magenta="#8042b8"
  bright_cyan="#007b85"
fi
tmp=$(mktemp "$base/.kitty-theme.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
  printf '# Generated by omi_shell. Import this file from kitty.conf.\n'
  printf 'background %s\n' "$background"
  printf 'foreground %s\n' "$terminal_foreground"
  printf 'cursor %s\n' "$accent"
  printf 'cursor_text_color %s\n' "$background"
  printf 'selection_background %s\n' "$accent"
  printf 'selection_foreground %s\n' "$background"
  printf 'url_color %s\n' "$accent"
  printf 'active_border_color %s\n' "$accent"
  printf 'inactive_border_color %s\n' "$muted"
  printf 'bell_border_color %s\n' "$accent"
  printf 'tab_bar_background %s\n' "$background"
  printf 'active_tab_background %s\n' "$accent"
  printf 'active_tab_foreground %s\n' "$background"
  printf 'inactive_tab_background %s\n' "$surface"
  printf 'inactive_tab_foreground %s\n' "$terminal_foreground"
  printf 'color0 %s\n' "$ansi_black"
  printf 'color1 %s\n' "$ansi_red"
  printf 'color2 %s\n' "$ansi_green"
  printf 'color3 %s\n' "$ansi_yellow"
  printf 'color4 %s\n' "$ansi_blue"
  printf 'color5 %s\n' "$ansi_magenta"
  printf 'color6 %s\n' "$ansi_cyan"
  printf 'color7 %s\n' "$terminal_foreground"
  printf 'color8 %s\n' "$bright_black"
  printf 'color9 %s\n' "$bright_red"
  printf 'color10 %s\n' "$bright_green"
  printf 'color11 %s\n' "$bright_yellow"
  printf 'color12 %s\n' "$bright_blue"
  printf 'color13 %s\n' "$bright_magenta"
  printf 'color14 %s\n' "$bright_cyan"
  printf 'color15 %s\n' "$foreground"
} > "$tmp"

if [[ ! -r $output ]] || ! cmp -s "$tmp" "$output"; then
  mv "$tmp" "$output"
fi
