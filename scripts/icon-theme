#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/omi_shell"
current=""
[[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")
theme_file="$base/themes/$current/theme.conf"
[[ -r $theme_file ]] || exit 0

icon_theme=""
accent="#89b4fa"
while IFS='=' read -r key value; do
  key=${key//[[:space:]]/}
  value=${value//[[:space:]\"]/}
  case "$key" in
    ICON_THEME) icon_theme=$value ;;
    ACCENT|BORDER_FOREGROUND) accent=$value ;;
  esac
done < "$theme_file"

if [[ -z $icon_theme || $icon_theme == auto ]]; then
  # Match by hue instead of raw RGB distance. Material palettes use bright,
  # desaturated accents, which otherwise appear closer to beige than blue.
  hex=${accent#\#}
  [[ $hex =~ ^[[:xdigit:]]{6}$ ]] || hex="89b4fa"
  r=$((16#${hex:0:2}))
  g=$((16#${hex:2:2}))
  b=$((16#${hex:4:2}))
  max=$r
  ((g > max)) && max=$g
  ((b > max)) && max=$b
  min=$r
  ((g < min)) && min=$g
  ((b < min)) && min=$b
  delta=$((max - min))

  if ((delta < 18)); then
    icon_theme="Yaru-sage-dark"
  else
    if ((max == r)); then
      hue=$((60 * (g - b) / delta))
      ((hue < 0)) && hue=$((hue + 360))
    elif ((max == g)); then
      hue=$((60 * (b - r) / delta + 120))
    else
      hue=$((60 * (r - g) / delta + 240))
    fi

    if ((hue < 15 || hue >= 345)); then icon_theme="Yaru-red-dark"
    elif ((hue < 45)); then icon_theme="Yaru-wartybrown-dark"
    elif ((hue < 80)); then icon_theme="Yaru-yellow-dark"
    elif ((hue < 145)); then icon_theme="Yaru-olive-dark"
    elif ((hue < 195)); then icon_theme="Yaru-prussiangreen-dark"
    elif ((hue < 255)); then icon_theme="Yaru-blue-dark"
    elif ((hue < 300)); then icon_theme="Yaru-purple-dark"
    else icon_theme="Yaru-magenta-dark"
    fi
  fi
fi

if [[ ! -d "/usr/share/icons/$icon_theme" && ! -d "$HOME/.local/share/icons/$icon_theme" && ! -d "$HOME/.icons/$icon_theme" ]]; then
  exit 0
fi

if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface icon-theme "$icon_theme" >/dev/null 2>&1 || true
fi

if command -v kwriteconfig6 >/dev/null 2>&1; then
  kwriteconfig6 --file kdeglobals --group Icons --key Theme --notify "$icon_theme" >/dev/null 2>&1 || true
  if [[ -f "$HOME/.config/qt6ct/qt6ct.conf" ]]; then
    kwriteconfig6 --file "$HOME/.config/qt6ct/qt6ct.conf" --group Appearance --key icon_theme "$icon_theme" >/dev/null 2>&1 || true
  fi
fi
