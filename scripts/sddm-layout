#!/usr/bin/env bash
# Az elo Hyprland monitorelrendezesbol general egy X11 Xsetup scriptet az SDDM-nek.
# Az SDDM sajat X szervert indit, ami nem ismeri a compositor elrendezeset: enelkul
# a kijelzok sorrendje/pozicioja mas lehet, mint a munkamenetben.
#
# Elsodleges kijelzo (ide kerul a bejelentkezo kartya es a billentyuzet fokusz):
# a `lockscreen-monitor`, kulonben a fokuszalt, kulonben az elso monitor.
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
[[ -d $base ]] || base="$(cd "$(dirname "$0")/.." && pwd)"

output=${1:-"$base/sddm/vellum-ink/Xsetup"}

command -v hyprctl >/dev/null 2>&1 || exit 0
command -v jq >/dev/null 2>&1 || exit 0

monitors=$(hyprctl monitors -j 2>/dev/null) || exit 0
[[ -n $monitors && $monitors != "[]" ]] || exit 0

primary=""
[[ -r "$base/lockscreen-monitor" ]] && primary=$(<"$base/lockscreen-monitor")
primary=${primary//[[:space:]]/}

known=$(printf '%s' "$monitors" | jq -r '.[].name')
if [[ -z $primary ]] || ! printf '%s\n' "$known" | grep -qx -- "$primary"; then
  primary=$(printf '%s' "$monitors" | jq -r 'map(select(.focused)) | .[0].name // empty')
fi
[[ -n $primary ]] || primary=$(printf '%s' "$monitors" | jq -r '.[0].name')

args=()
while IFS=$'\t' read -r name mode pos; do
  [[ -n $name ]] || continue
  args+=("--output" "$name" "--mode" "$mode" "--pos" "$pos" "--rotate" "normal")
  [[ $name == "$primary" ]] && args+=("--primary")
done < <(printf '%s' "$monitors" | jq -r '.[] | "\(.name)\t\(.width)x\(.height)\t\(.x)x\(.y)"')

((${#args[@]})) || exit 0

mkdir -p "$(dirname "$output")"
tmp=$(mktemp "$(dirname "$output")/.Xsetup.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
  printf '#!/bin/sh\n'
  printf '# Generated by vellum_shell scripts/sddm-layout – ne szerkeszd kezzel.\n'
  printf '# Primary: %s\n' "$primary"
  printf 'xrandr'
  printf ' %s' "${args[@]}"
  printf ' 2>/dev/null || true\n'
} > "$tmp"

if [[ ! -r $output ]] || ! cmp -s "$tmp" "$output"; then
  mv "$tmp" "$output"
fi
chmod 755 "$output"
printf '%s\n' "$output"
