#!/usr/bin/env bash
# Reports who holds a /dev/video* capture handle. One line per state change:
#   0                            nobody is using a camera
#   1 <name>:<device>[,...]      these processes hold these handles
#
# The kernel has no "camera opened" event, so this stays resident and polls
# /proc instead of the shell forking a checker on every tick. With no video
# device present a cycle costs a glob and nothing else, so hotplugged USB
# cameras are picked up without keeping a scanner busy on machines that have
# no camera at all.
set -u
shopt -s nullglob

interval=${1:-3}
previous=""

while :; do
  state="0"
  devices=(/dev/video*)

  if ((${#devices[@]})); then
    users=""
    while IFS=$'\t' read -r fd_dir device; do
      pid_dir=${fd_dir%/fd}
      [[ -r $pid_dir/comm ]] || continue
      name=$(<"$pid_dir/comm")
      [[ -n $name ]] || continue
      # The reader splits on ':' and ',', so they cannot survive in a name.
      name=${name//[:,]/_}
      entry="$name:$device"
      [[ ",$users," == *",$entry,"* ]] && continue
      users=${users:+$users,}$entry
    done < <(find /proc/[0-9]*/fd -maxdepth 1 -lname '/dev/video*' -printf '%h\t%l\n' 2>/dev/null | sort -u)
    [[ -n $users ]] && state="1 $users"
  fi

  if [[ $state != "$previous" ]]; then
    printf '%s\n' "$state"
    previous=$state
  fi

  sleep "$interval"
done
