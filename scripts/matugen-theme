#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
bgdir="$HOME/Pictures/wallpapers"
wallpaper=${1:-}
out_dir="$base/themes/dynamic-matugen"
out="$out_dir/theme.conf"

[[ -n $wallpaper && -r $wallpaper ]] || wallpaper=""
[[ -n $wallpaper ]] || { [[ -r "$base/current-wallpaper" ]] && wallpaper=$(<"$base/current-wallpaper"); }
# Fall back to the first wallpaper on disk; if there is none, leave it empty and
# the built-in palette below is used instead.
[[ -r $wallpaper ]] || wallpaper=$(find "$bgdir" -maxdepth 1 -type f \
  \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) \
  2>/dev/null | sort | head -n 1)
[[ -r $wallpaper ]] || wallpaper=""

background="#15130c"
foreground="#e8e2d4"
accent="#d8c770"
surface="#222017"
muted="#ccc6b5"

if command -v matugen >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && [[ -r $wallpaper ]]; then
  # The most saturated sample is often a tiny highlight and can tint an
  # otherwise neutral wallpaper incorrectly. Use Matugen's dominant extracted
  # source colour for a stable palette that reflects the whole image.
  fallback_color="#808080"
  json=$(matugen image "$wallpaper" --json hex --dry-run --mode dark --type scheme-tonal-spot \
    --source-color-index 0 --fallback-color "$fallback_color" 2>/dev/null || true)
  # Matugen otherwise falls back to blue when a monochrome image has no usable
  # source colour. Keep such wallpapers neutral instead of inventing a hue.
  if [[ $(jq -r '.colors.source_color.default.color // empty' <<<"$json") == "$fallback_color" ]]; then
    json=$(matugen image "$wallpaper" --json hex --dry-run --mode dark --type scheme-monochrome \
      --source-color-index 0 --fallback-color "$fallback_color" 2>/dev/null || true)
  fi
  if [[ -n $json ]]; then
    background=$(jq -r '.colors.background.default.color // .colors.surface.default.color // empty' <<<"$json")
    foreground=$(jq -r '.colors.on_surface.default.color // .colors.on_background.default.color // empty' <<<"$json")
    accent=$(jq -r '.colors.primary.default.color // .colors.secondary.default.color // empty' <<<"$json")
    surface=$(jq -r '.colors.surface_container.default.color // .colors.surface.default.color // empty' <<<"$json")
    muted=$(jq -r '.colors.on_surface_variant.default.color // .colors.outline.default.color // empty' <<<"$json")
  fi
fi

valid_color() {
  [[ $1 =~ ^#[[:xdigit:]]{6}$ ]]
}

valid_color "$background" || background="#15130c"
valid_color "$foreground" || foreground="#e8e2d4"
valid_color "$accent" || accent="#d8c770"
valid_color "$surface" || surface="#222017"
valid_color "$muted" || muted="#ccc6b5"

mkdir -p "$out_dir"
tmp=$(mktemp "$out_dir/.theme.XXXXXX")
trap 'rm -f "$tmp"' EXIT
{
  printf 'NAME=Dynamic / Matugen\n'
  printf 'BACKGROUND=%s\n' "$background"
  printf 'FOREGROUND=%s\n' "$foreground"
  printf 'ACCENT=%s\n' "$accent"
  printf 'SURFACE=%s\n' "$surface"
  printf 'MUTED=%s\n' "$muted"
  printf 'ICON_THEME=auto\n'
} > "$tmp"

mv "$tmp" "$out"
trap - EXIT

cat "$out"
