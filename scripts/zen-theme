#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
source_file=${1:-}
output="$base/zen-theme.css"

if [[ ! -r $source_file ]]; then
  current=""
  [[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")
  source_file="$base/themes/$current/theme.conf"
fi

[[ -r $source_file ]] || exit 0

background="#1e1e2e"
foreground="#cdd6f4"
accent="#89b4fa"
surface="#181825"
muted="#9399b2"
selection=""
dark_background=""
lighter_background=""
red=""
yellow=""
orange=""
green=""
cyan=""
blue=""
magenta=""

while IFS='=' read -r key value; do
  key=${key//[[:space:]]/}
  value=${value//[[:space:]\"]/}
  case "$key" in
    BACKGROUND) background=$value ;;
    FOREGROUND) foreground=$value ;;
    ACCENT|BORDER_FOREGROUND) accent=$value ;;
    SURFACE) surface=$value ;;
    MUTED) muted=$value ;;
    SELECTION) selection=$value ;;
    DARK_BACKGROUND) dark_background=$value ;;
    LIGHTER_BACKGROUND) lighter_background=$value ;;
    RED) red=$value ;;
    YELLOW) yellow=$value ;;
    ORANGE) orange=$value ;;
    GREEN) green=$value ;;
    CYAN) cyan=$value ;;
    BLUE) blue=$value ;;
    MAGENTA) magenta=$value ;;
  esac
done < "$source_file"

valid_color() {
  [[ $1 =~ ^#[[:xdigit:]]{6}$ ]]
}

valid_color "$background" || background="#1e1e2e"
valid_color "$foreground" || foreground="#cdd6f4"
valid_color "$accent" || accent="#89b4fa"
valid_color "$surface" || surface="#181825"
valid_color "$muted" || muted="#9399b2"

mix() {
  local first=${1#\#} second=${2#\#} weight=$3 channel a b mixed result=""
  for channel in 0 2 4; do
    a=$((16#${first:channel:2}))
    b=$((16#${second:channel:2}))
    mixed=$(((a * weight + b * (100 - weight)) / 100))
    printf -v result '%s%02x' "$result" "$mixed"
  done
  printf '#%s' "$result"
}

valid_color "$selection" || selection="$accent"
valid_color "$dark_background" || dark_background="$background"
valid_color "$lighter_background" || lighter_background="$surface"
valid_color "$red" || red=$(mix "#ff5449" "$foreground" 70)
valid_color "$yellow" || yellow=$(mix "$foreground" "$accent" 75)
valid_color "$orange" || orange=$(mix "$accent" "$foreground" 85)
valid_color "$green" || green=$(mix "$muted" "$foreground" 65)
valid_color "$cyan" || cyan="$accent"
valid_color "$blue" || blue=$(mix "$accent" "$foreground" 70)
valid_color "$magenta" || magenta=$(mix "$accent" "$background" 35)

primary=$(mix "$accent" "$background" 45)
selection_text="$foreground"
url_color=$(mix "$muted" "$foreground" 75)
identity_pink=$(mix "$accent" "$foreground" 55)

tmp=$(mktemp "$base/.zen-theme.XXXXXX")
trap 'rm -f "$tmp"' EXIT

cat > "$tmp" <<EOF
/* Generated by vellum_shell. Import this file from Zen Browser's userChrome CSS. */
:root {
  --zen-primary-color: $primary !important;
  --toolbarbutton-icon-fill: $accent !important;
  --toolbar-field-color: $foreground !important;
  --tab-selected-textcolor: $accent !important;
  --toolbar-color: $foreground !important;
  --arrowpanel-color: $foreground !important;
  --arrowpanel-background: $lighter_background !important;
  --sidebar-text-color: $foreground !important;
  --zen-navigator-toolbox-background: $background !important;
  --zen-main-browser-background: $dark_background !important;
  --zen-main-browser-background-toolbar: $background !important;
}

#zen-browser-background {
  --zen-main-browser-background: $dark_background !important;
  --zen-background-opacity: 1 !important;
}

#zen-toolbar-background {
  --zen-main-browser-background-toolbar: $background !important;
  --zen-background-opacity: 1 !important;
}

.sidebar-placesTree {
  background-color: $lighter_background !important;
}

#zen-workspaces-button,
#zen-workspace-icons {
  background-color: $background !important;
}

#TabsToolbar {
  background-color: $background !important;
}

#zen-sidebar-top-buttons-customization-target,
#zen-sidebar-splitter {
  background-color: $background !important;
}

#zen-sidebar-splitter {
  opacity: 1 !important;
}

.urlbar-background {
  background-color: $lighter_background !important;
}

.urlbar-input::selection {
  color: $selection_text !important;
  background-color: $selection !important;
}

.urlbarView-url {
  color: $url_color !important;
}

toolbar .toolbarbutton-1 {
  &:not([disabled]) {
    &:is([open], [checked])
      > :is(
        .toolbarbutton-icon,
        .toolbarbutton-text,
        .toolbarbutton-badge-stack
      ) {
      fill: $accent;
    }
  }
}

.identity-color-blue {
  --identity-tab-color: $blue !important;
  --identity-icon-color: $blue !important;
}

.identity-color-turquoise {
  --identity-tab-color: $cyan !important;
  --identity-icon-color: $cyan !important;
}

.identity-color-green {
  --identity-tab-color: $green !important;
  --identity-icon-color: $green !important;
}

.identity-color-yellow {
  --identity-tab-color: $yellow !important;
  --identity-icon-color: $yellow !important;
}

.identity-color-orange {
  --identity-tab-color: $orange !important;
  --identity-icon-color: $orange !important;
}

.identity-color-red {
  --identity-tab-color: $red !important;
  --identity-icon-color: $red !important;
}

.identity-color-pink {
  --identity-tab-color: $identity_pink !important;
  --identity-icon-color: $identity_pink !important;
}

.identity-color-purple {
  --identity-tab-color: $magenta !important;
  --identity-icon-color: $magenta !important;
}

#zen-appcontent-navbar-container {
  background-color: $background !important;
}

#PanelUI-menu-button .toolbarbutton-icon,
#downloads-button .toolbarbutton-icon,
#unified-extensions-button .toolbarbutton-icon {
  fill: $accent !important;
  color: $accent !important;
}

#PanelUI-menu-button .toolbarbutton-badge-stack,
#downloads-button .toolbarbutton-badge-stack,
#unified-extensions-button .toolbarbutton-badge-stack {
  fill: $accent !important;
  color: $accent !important;
}

toolbar .toolbarbutton-1 > .toolbarbutton-icon {
  fill: $accent !important;
}
EOF

if [[ ! -r $output ]] || ! cmp -s "$tmp" "$output"; then
  mv "$tmp" "$output"
fi

# Zen Mods regenerates zen-themes.css, so keep its Vellum import pointed at
# this shell's current location whenever the palette is applied.
zen_root="$HOME/.config/zen"
if [[ -r "$zen_root/installs.ini" ]]; then
  zen_profile=""
  while IFS='=' read -r key value; do
    [[ $key == Default ]] || continue
    zen_profile=$value
    break
  done < "$zen_root/installs.ini"

  zen_css="$zen_root/$zen_profile/chrome/zen-themes.css"
  if [[ -n $zen_profile && -r $zen_css ]]; then
    import='@import url("'"$output"'");'
    import_tmp=$(mktemp "$zen_root/$zen_profile/chrome/.vellum-import.XXXXXX")
    import_found=false
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line == '@import url("'*'/zen-theme.css");' ]]; then
        printf '%s\n' "$import" >> "$import_tmp"
        import_found=true
      else
        printf '%s\n' "$line" >> "$import_tmp"
      fi
    done < "$zen_css"
    if [[ $import_found == false ]]; then
      { printf '%s\n\n' "$import"; cat "$import_tmp"; } > "$import_tmp.with-import"
      mv "$import_tmp.with-import" "$import_tmp"
    fi
    if ! cmp -s "$import_tmp" "$zen_css"; then
      mv "$import_tmp" "$zen_css"
    else
      rm -f "$import_tmp"
    fi
  fi

fi
