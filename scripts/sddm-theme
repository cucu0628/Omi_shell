#!/usr/bin/env bash
# A Vellum Shell aktualis palettajabol generalja a Vellum Ink SDDM tema theme.conf-jat.
# A repoban levo peldanyt mindig frissiti, a telepitett rendszerpeldanyt pedig
# akkor, ha az irhato (a sddm-install a hivo felhasznalora chownolja).
# Hasznalat: sddm-theme [forras-theme.conf] [tovabbi-cel-theme.conf ...]
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
[[ -d $base ]] || base="$(cd "$(dirname "$0")/.." && pwd)"

source_file=${1:-}
[[ $# -gt 0 ]] && shift

if [[ ! -r $source_file ]]; then
  current=""
  [[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")
  source_file="$base/themes/$current/theme.conf"
fi

[[ -r $source_file ]] || exit 0

name="Vellum Shell"
background="#1e1e2e"
foreground="#cdd6f4"
accent="#89b4fa"
surface="#181825"
muted="#9399b2"
red="#d7472f"

while IFS='=' read -r key value; do
  key=${key//[[:space:]]/}
  value=${value%$'\r'}
  case "$key" in
    NAME) name=${value# } ;;
    BACKGROUND) background=${value//[[:space:]\"]/} ;;
    FOREGROUND) foreground=${value//[[:space:]\"]/} ;;
    ACCENT|BORDER_FOREGROUND) accent=${value//[[:space:]\"]/} ;;
    SURFACE) surface=${value//[[:space:]\"]/} ;;
    MUTED) muted=${value//[[:space:]\"]/} ;;
    LIGHT_FOREGROUND) muted=${value//[[:space:]\"]/} ;;
    RED) red=${value//[[:space:]\"]/} ;;
  esac
done < "$source_file"

valid_color() {
  [[ $1 =~ ^#[[:xdigit:]]{6}$ ]]
}

valid_color "$background" || background="#1e1e2e"
valid_color "$foreground" || foreground="#cdd6f4"
valid_color "$accent" || accent="#89b4fa"
valid_color "$surface" || surface="#181825"
valid_color "$muted" || muted="#9399b2"
valid_color "$red" || red="#d7472f"

# A greeter azon a kepernyon mutatja a bejelentkezo kartyat, amelyiken a
# lockscreen is bekeri a jelszot. Ures ertek eseten a rendszer elsodleges
# kepernyoje dont.
input_screen=""
[[ -r "$base/lockscreen-monitor" ]] && input_screen=$(<"$base/lockscreen-monitor")
input_screen=${input_screen//[[:space:]]/}

payload=$(
  printf '[General]\n'
  printf '# Generated by Vellum Shell scripts/sddm-theme – ne szerkeszd kezzel.\n'
  printf 'themeName=%s\n' "$name"
  printf 'inputScreen=%s\n' "$input_screen"
  printf 'colorBackground=%s\n' "$background"
  printf 'colorForeground=%s\n' "$foreground"
  printf 'colorAccent=%s\n' "$accent"
  printf 'colorSurface=%s\n' "$surface"
  printf 'colorMuted=%s\n' "$muted"
  printf 'colorAlert=%s\n' "$red"
)

write_conf() {
  local target=$1

  # Meglevo, valtozatlan fajlt nem irunk ujra.
  if [[ -r $target ]] && [[ $payload == "$(<"$target")" ]]; then
    return 0
  fi

  if [[ -e $target ]]; then
    # Helyben irunk, hogy elegendo legyen a fajlra kapott irasi jog.
    [[ -w $target ]] || return 0
    printf '%s\n' "$payload" > "$target"
  else
    local dir
    dir=$(dirname "$target")
    [[ -w $dir ]] || return 0
    printf '%s\n' "$payload" > "$target"
    chmod 644 "$target"
  fi
}

targets=("$base/sddm/vellum-ink/theme.conf" "/usr/share/sddm/themes/vellum-ink/theme.conf" "$@")

for target in "${targets[@]}"; do
  [[ -n $target ]] || continue
  write_conf "$target"
done
